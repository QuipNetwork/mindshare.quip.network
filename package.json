{
  "name": "mindshare.quip.network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev --context dev",
    "build": "astro build",
    "lint": "eslint .",
    "preview": "netlify serve --context dev",
    "format": "prettier --plugin prettier-plugin-astro --write \"src/**/*.{ts,tsx,astro,css,md}\"",
    "check": "astro check && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@netlify/functions": "^3.0.4",
    "@tailwindcss/vite": "^4.0.17",
    "clsx": "^2.1.1",
    "netlify-cli": "^27.11.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.5.2",
    "tailwindcss": "^4.0.17",
    "zustand": "^5.0.11",
    "astro": "^7.3.5",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/netlify": "^8.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "@astrojs/check": "^0.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier-plugin-astro": "^0.14.1"
  }
}
